############################################################
#                                                          #
#              Rede vIRCio - vIRCio.modules                #
#                                                          #
#     CONFIGURACAO PADRAO E IMUTAVEL DA REDE vIRCio       #
#                                                          #
# Nao altere este arquivo individualmente em um IRCd.      #
#                                                          #
############################################################


# ==========================================================
# Hash / criptografia
# ==========================================================

<module name="sha1">
<module name="sha2">
<module name="bcrypt">
<bcrypt rounds="12">
<module name="password_hash">
<mkpasswd operonly="yes">


# ==========================================================
# TLS
# ==========================================================

<module name="ssl_openssl">
<module name="sslrehashsignal">
<module name="sslinfo">
<module name="sslmodes">

<sslinfo
    hash="sha-256"
    localsecure="yes"
    operonly="no"
    warnexpiring="1w"
    welcomemsg="no">

<sslmodes extbanoperonly="yes">

# Habilita TLS em listener plaintext.
#<module name="starttls">


# ==========================================================
# Cloaking
# ==========================================================

<module name="cloak">
<module name="cloak_sha256">

<cloak
    method="hmac-sha256"
    key="&cloakKey;"
    class=""
    prefix="vIRCio"
    suffix="IP"
    case="lower"
    hostparts="3"
    pathparts="1">


# ==========================================================
# Comandos e recursos gerais
# ==========================================================

<module name="abbreviation">
<module name="alias">
<module name="allowinvite">
<module name="alltime">
<module name="cycle">

<fantasy
    prefix="!"
    allowbots="yes">


# Aliases em portugues para comandos comuns.

<alias text="REGRAS" replace="RULES">
<alias text="APELIDO" replace="NICK :$2-">
<alias text="ENTRAR" replace="JOIN :$2-">
<alias text="SAIR" replace="PART :$2-">


# ==========================================================
# CAP / IRCv3
# ==========================================================

<module name="cap">

<module name="ircv3">

<ircv3
    accountnotify="yes"
    awaynotify="yes"
    extendedjoin="yes"
    noimplicitnames="yes"
    standardreplies="yes">

<module name="ircv3_accounttag">
<module name="ircv3_batch">
<module name="ircv3_capnotify">
<module name="ircv3_chghost">
<module name="ircv3_ctctags">
<module name="ircv3_echomessage">
<module name="ircv3_invitenotify">
<module name="ircv3_labeledresponse">
<module name="ircv3_msgid">
<module name="ircv3_servertime">
<module name="ircv3_utf8only">

# Exige TLS para conexoes subsequentes ao host configurado.
# Requer certificado TLS publico valido.
#<module name="ircv3_sts">
#<sts
#    host="*.vircio.net"
#    duration="30d"
#    port="6697"
#    preload="no">


# ==========================================================
# Contas, Services e autenticacao SASL.
# ==========================================================

<module name="account">
<module name="services">
<module name="sasl">

<servicesintegration
    accountoverrideshold="no"
    disablemodes="no">

<sasl
    target="services.vircio.net"
    requiressl="yes">


# ==========================================================
# Gateways WebIRC e clientes WebSocket.
# ==========================================================

<module name="gateway">
<module name="websocket">

<websocket
    defaultmode="text"
    allowmissingorigin="no"
    nativeping="yes">

<wsorigin allow="https://*.vircio.net">

# Gateways WEBIRC autorizados exigem origem e credenciais definidas.
#<gateway
#    type="webirc"
#    password="HASH_BCRYPT"
#    hash="bcrypt"
#    mask="127.0.0.1">
#
# O nome WEBIRC seleciona a connect class correspondente.


# ==========================================================
# Contrib: experiencia do usuario e protecao.
# ==========================================================

# Aplica <options:defaulttopic> a canais novos.
<module name="defaulttopic">

# Marca usuarios inativos como AWAY apos uma hora.
<module name="autoaway">

<autoaway
    checkperiod="15m"
    idleperiod="1h"
    message="Away due to inactivity. Ausente por inatividade.">

# Usermode +a oculta idle e signon no WHOIS comum.
<module name="hideidle">

# Desconecta clientes nao registrados que enviam comandos HTTP/scanner.
<module name="autodrop">

<autodrop
    commands="CONNECT DELETE GET HEAD OPTIONS PATCH POST PUT TRACE">

# Limita mudancas rapidas entre muitos destinos para reduzir spam.
<module name="tgchange">

<tgchange
    num="20"
    reply="10">


# Impoe atraso para reutilizacao de nicks e canais recentemente liberados.
# <module name="delayuse">
#
# <delay
#     chan="30s"
#     nick="30s">


# ==========================================================
# Canais, modos e protecoes associadas.
# ==========================================================

<module name="anticaps">
<module name="auditorium">
<module name="autoop">
<module name="banexception">
<module name="blockcolor">
<module name="botmode">
<module name="callerid">
<module name="cban">
<module name="chancreate">
<module name="chanfilter">
<module name="chanhistory">
<module name="chanlog">
<module name="channames">
<module name="channelban">
<module name="commonchans">
<module name="customprefix">
<module name="deaf">
<module name="delayjoin">
<module name="delaymsg">
<module name="denychans">
<module name="exemptchanops">
<module name="inviteexception">
<module name="joinflood">
<module name="kicknorejoin">
<module name="knock">
<module name="messageflood">
<module name="muteban">
<module name="namedmodes">
<module name="nickflood">
<module name="noctcp">
<module name="nokicks">
<module name="nonicks">
<module name="nonotice">
<module name="redirect">
<module name="remove">
<module name="repeat">
<module name="stripcolor">
<module name="timedbans">
<module name="uninvite">


<auditorium
    opvisible="yes"
    opcansee="no"
    opercansee="yes">

<callerid
    maxaccepts="24"
    tracknick="yes"
    cooldown="1m">

<chanfilter
    hidemask="yes"
    maxlen="50"
    notifyuser="yes">

<chanhistory
    maxlines="50"
    maxduration="4w"
    prefixmsg="yes"
    savefrombots="yes"
    sendtobots="yes">

# Logs administrativos no canal da equipe.
<chanlog
    snomasks="acdfgjklnoqrtvwx"
    channel="#ServerS">

<channames
    denyrange="2,3"
    allowrange="">

<customprefix
    name="founder"
    letter="q"
    prefix="~"
    rank="50000"
    ranktoset="50000">

<customprefix
    name="admin"
    letter="a"
    prefix="&amp;"
    rank="40000"
    ranktoset="50000">

<customprefix
    name="halfop"
    letter="h"
    prefix="%"
    rank="20000"
    ranktoset="30000">

<customprefix
    name="halfvoice"
    letter="V"
    prefix="-"
    rank="1"
    ranktoset="20000">

<badchan
    name="#IRCops"
    allowopers="yes"
    reason="IRCops">

<badchan
    name="#ServiceS"
    allowopers="yes"
    reason="IRCops">

<badchan
    name="#ServerS"
    allowopers="yes"
    reason="IRCops">

<inviteexception bypasskey="yes">

<joinflood
    duration="1m"
    bootwait="30s"
    splitwait="30s"
    notifyrank="0">

<knock notify="notice">

<nickflood
    duration="1m"
    notifyrank="0">

<redirect
    ban="no"
    extban="yes"
    inviteonly="yes"
    key="yes"
    limit="yes">

<remove
    supportnokicks="yes"
    protectedrank="50000">

<repeat
    maxbacklog="20"
    maxdistance="50"
    maxlines="20"
    maxtime="0s"
    size="512"
    extended="yes">

<timedbans sendnotice="yes">


# ==========================================================
# Ocultacao de informacoes
# ==========================================================

<module name="hidechans">
<module name="hidelist">
<module name="hideoper">

<hidechans
    affectsopers="no"
    hideservices="yes">

# Oculta listas de ban exception e invite exception de usuarios sem rank.
<hidelist
    mode="banexception"
    rank="20000">

<hidelist
    mode="invex"
    rank="20000">


# ==========================================================
# SecureList
# ==========================================================
#
# Protege o /LIST contra spambots logo apos a conexao.
#
# Usuarios autenticados em conta ficam isentos imediatamente.
# Nao envia canais falsos.
#

<module name="securelist">

# Excecoes oficiais mantidas pelo InspIRCd para crawlers
# conhecidos.
<include
    file="&dir.example;/providers/securelist.example.conf"
    missingokay="yes">

<securelist
    exemptregistered="yes"
    fakechans="0"
    hidesmallchans="0"
    showmsg="yes"
    waittime="30s">


# ==========================================================
# Connect / protecao contra conexoes
# ==========================================================

# Entra automaticamente em canais configurados no connect class.
#<module name="conn_join">
<module name="conn_umodes">
<module name="connectban">
<module name="connflood">

<connectban
    threshold="20"
    banduration="10m"
    ipv4cidr="32"
    ipv6cidr="64"
    bootwait="2m"
    splitwait="2m"
    banmessage="Too many connection attempts. Aguarde antes de conectar novamente.">

<connflood
    period="30s"
    maxconns="15"
    timeout="30s"
    quitmsg="Connection throttled. Conexao limitada."
    bootwait="2m">

# Exige resposta ao PING inicial antes de concluir a conexao.
#<module name="conn_waitpong">


# ==========================================================
# DNSBL
# ==========================================================

<module name="dnsbl">

# Listas DNSBL mantidas pelo InspIRCd.
<include file="&dir.example;/providers/dronebl.example.conf">
<include file="&dir.example;/providers/efnet-rbl.example.conf">


# ==========================================================
# Geolocalizacao por IP e recursos dependentes.
# ==========================================================

# Requer base GeoIP/MaxMind configurada.
#<module name="geo_maxmind">
#<module name="geoban">
#<module name="geoclass">


# ==========================================================
# Filtros globais por expressao regular.
# ==========================================================

<module name="regex_pcre2">
<module name="filter">

<filteropts
    engine="pcre"
    enableflags="yes"
    notifyuser="yes"
    warnonselfmsg="yes">

# Regras estaticas da Rede vIRCio; warn permite a mensagem e avisa a snomask FILTER.
<include file="vIRCio.filters" missingokay="yes">


# ==========================================================
# Bans por realname, regex e X-Lines.
# ==========================================================

<module name="realnameban">
<module name="rline">
<module name="rmode">
<module name="serverban">
<module name="shun">
<module name="tline">
<module name="xline_db">

<rline
    matchonnickchange="yes"
    useflags="yes"
    zlineonmatch="no"
    engine="pcre">

<serverban operonly="yes">

<shun
    enabledcommands="ADMIN PING PONG QUIT PART JOIN"
    cleanedcommands="AWAY PART QUIT"
    allowconnect="no"
    allowtags="no"
    notifyuser="no">

<xlinedb
    filename="vIRCio.xline"
    saveperiod="5s"
    backoff="2"
    maxbackoff="5m">


# ==========================================================
# Persistencia de canais permanentes.
# ==========================================================

<module name="permchannels">

<permchanneldb
    filename="vIRCio.permchannels"
    listmodes="yes"
    saveperiod="5s"
    backoff="2"
    maxbackoff="5m"
    operonly="yes"
    writeversion="2">

<include
    file="vIRCio.permchannels"
    missingokay="yes">


# ==========================================================
# Notificacao de disponibilidade de apelidos.
# ==========================================================

<module name="watch">
<module name="monitor">

<watch maxwatch="32">
<monitor maxentries="30">


# ==========================================================
# Comandos e recursos administrativos.
# ==========================================================

<module name="check">

# Mostra IPs ou CIDRs com multiplas conexoes.
<module name="clones">

# Adiciona /STATS X para servidores configurados e nao linkados.
<module name="stats_unlinked">
# Redireciona clientes para outro IRCd com /JUMPSERVER.
<module name="jumpserver">
# Controla novas conexoes com /LOCKSERV e /UNLOCKSERV.
<module name="lockserv">
# Ferramentas XCOPY, XCOUNT, XREMOVE e XSEARCH para X-Lines.
<module name="xlinetools">
<module name="chghost">
<module name="chgident">
<module name="chgname">

<module name="globalload">
<module name="globops">

<module name="nicklock">

<module name="ojoin">
<module name="operchans">
<module name="operjoin">
<module name="operlevels">
<module name="operlog">
<module name="opermodes">
<module name="opermotd">

<opermotd
    file="vIRCio.opermotd"
    onoper="yes">
<module name="override">

<module name="sajoin">
<module name="sakick">
<module name="samode">
<module name="sanick">
<module name="sapart">
<module name="saquit">
<module name="satopic">

<module name="seenicks">

<module name="sethost">
<module name="setident">
<module name="setidle">
<module name="setname">

<module name="showwhois">
# Substitui SWHOIS nativo com multiplas entradas e ADD/DEL/CLEAR/LIST.
<module name="swhois_ext">


<hostname
    charmap="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-_/0123456789">

<ojoin
    prefix="!"
    notice="yes"
    op="no">

<operjoin
    channel="#IRCops"
    override="no">

<operlog tosnomask="no">

<override
    noisy="yes"
    requirekey="no"
    timeout="30m">

<setname
    notifyopers="no"
    operonly="no">

<showwhois opersonly="no">


# Adiciona prefixo de canal para IRCops.
#<module name="operprefix">
#<operprefix prefix="!">


# ==========================================================
# Ajuda e usermode +h para Helpers nao-oper.
# ==========================================================

<module name="help">

# Topicos de ajuda da Rede vIRCio.
<include file="vIRCio.helpop" missingokay="yes">


# ==========================================================
# Encaminha senha ao Services solicitado durante o registro.
# ==========================================================

<module name="passforward">

<passforward
    nick="NickServ"
    forwardmsg="NOTICE %nick% :*** Forwarding password to %nickrequired%. Encaminhando senha para %nickrequired%."
    cmd="SQUERY %nickrequired% :IDENTIFY %nick% %pass%">


# ==========================================================
# Lista de ignorados no servidor.
# ==========================================================

<module name="silence">

<silence
    maxentries="32"
    exemptservice="yes">


# ==========================================================
# Exibe multiplos prefixos e user@host no NAMES.
# ==========================================================

<module name="multiprefix">
<module name="uhnames">


# ==========================================================
# VHosts definidos localmente.
# ==========================================================

<module name="vhost">

# Define vhost autenticado por credenciais locais.
#<vhost
#    user="usuario"
#    password="HASH"
#    hash="bcrypt"
#    host="usuario.vircio.net">


# ==========================================================
# Titulos e vhosts autenticados.
# ==========================================================

<module name="customtitle">

#<title
#    name="helper"
#    password="HASH_BCRYPT"
#    hash="bcrypt"
#    host="*@*"
#    title="Official Chat Helper"
#    vhost="helper.vircio.net">


# ==========================================================
# Topologia e sincronizacao entre IRCds.
# ==========================================================

<module name="spanningtree">


# ==========================================================
# Modulos personalizados vIRCio
# ==========================================================

# /IRCOPS ordena a equipe e reconhece Helpers nao-oper por +h ou @op/superior
# nos canais de ajuda; respeita +H e users/auspex.
<module name="vircio_ircops">

<vircioircops
    helperlevel="20"
    helperchannels="#Ajuda #Help #vIRCio">


# Protege IRC Admin humanos com level minimo e privilegio configurado.
# Deve estar carregado em todos os IRCds da rede.
<module name="vircio_admin">

<vircioadmin
    minlevel="100"
    privilege="users/vircio-admin">


# Usermode +Q oculta presenca e membership de usuarios sem users/auspex.
# Deve estar carregado em todos os IRCds da rede.
<module name="vircio_invisible">

<vircioinvisible
    join="yes"
    names="yes"
    who="yes"
    whois="yes"
    msg="yes"
    seepriv="users/auspex">

# PRETENDUSER executa comando como outro usuario, controlado por comando e
# users/pretenduser.
<module name="vircio_pretenduser">

# Usermode +Z coloca usuario em quarentena, permitindo #vIRCio e Services.
# Deve estar carregado em todos os IRCds da rede.
<module name="vircio_zombie">

<virciozombie
    channel="#vIRCio"
    notice="*** Authentication required. Identifique-se ou registre conta nos Services. Use /NICKSERV HELP.">


