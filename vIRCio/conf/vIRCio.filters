############################################################
#                                                          #
#              Rede vIRCio - vIRCio.filters                #
#                                                          #
#     CONFIGURACAO PADRAO E IMUTAVEL DA REDE vIRCio       #
#                                                          #
# Regras globais do modulo filter utilizando PCRE2.         #
#                                                          #
############################################################


# ==========================================================
# SPAM / MALWARE
# ==========================================================
#
# Expressoes PCRE2 usam [.] para pontos literais.
#

<keyword
    pattern="abrege[.]eu"
    reason="Virus spam. Spam de virus."
    action="block"
    flags="qPopn">

<keyword
    pattern="weba[.]im"
    reason="Virus spam. Spam de virus."
    action="block"
    flags="qPopn">


# ==========================================================
# ALERTA DE DIVULGACAO DE IRC
# ==========================================================
# Permite a mensagem e avisa os IRCops pelo snomask FILTER.

<keyword
    pattern="irc[.]"
    reason="IRC promotion. Divulgacao de IRC."
    action="warn"
    flags="pqoPn">


# ==========================================================
# REGRAS DESABILITADAS
# ==========================================================
#
# Mantidas para referencia, sem efeito na rede.
#
#<keyword
#    pattern="irc[.]brasirc"
#    reason="Other network spam. Spam de outra rede."
#    action="block"
#    flags="qPopn">
#
#<keyword
#    pattern="irc[.]virtualife"
#    reason="Other network spam. Spam de outra rede."
#    action="block"
#    flags="qPopn">
#
#<keyword
#    pattern="vircio"
#    reason="IRC promotion. Divulgacao de IRC."
#    action="warn"
#    flags="pqoPn">


# ==========================================================
# CANAIS ISENTOS
# ==========================================================
#
# A comparacao respeita o case mapping IRC.
# A isencao cobre PRIVMSG, NOTICE e motivos de PART; QUIT nao possui alvo.
#

<exemptfromfilter target="#IRCops">
<exemptfromfilter target="#Ajuda">
<exemptfromfilter target="#Help">
<exemptfromfilter target="#vIRCio">


# ==========================================================
# CENSOR
# ==========================================================
#
# As regras antigas substituiam "virtualife" e "brasirc" por "(spam)".
# O modulo filter bloqueia ou alerta, mas nao substitui texto; essas regras
# nao sao aplicadas para preservar a semantica original.
#

############################################################
