#    sslprofile="Servers"
#    statshidden="no"
#    hidden="no"
#    sendpass="SENHA_DE_ENVIO"
#    recvpass="SENHA_DE_RECEBIMENTO">

#<autoconnect
#    bootperiod="15s"
#    period="5m"
#    server="irc2.vircio.net">


# ==========================================================
# Link com Services / Anope
# ==========================================================
#
# Para o deployment padrao, Anope e InspIRCd executam no mesmo
# host. O Anope inicia a conexao em 127.0.0.1:7008.
#
# Nao use <autoconnect> para services.vircio.net.
#
# As credenciais abaixo sao placeholders. Secrets reais ficam
# apenas no runtime e nunca entram no Git.
#

#<link
#    name="services.vircio.net"
#    ipaddr="127.0.0.1"
#    port="&servicesPort;"
#    allowmask="127.0.0.1"
#    timeout="30s"
#    statshidden="yes"
#    hidden="yes"
#    sendpass="SENHA_LINK_SERVICES"
#    recvpass="SENHA_LINK_SERVICES">

#<services
#    server="services.vircio.net"
#    silent="yes">


# ----------------------------------------------------------
# Services em outro servidor
# ----------------------------------------------------------
#
# Se Anope e InspIRCd forem separados futuramente, NAO exponha
# o listener plaintext acima para a Internet.
#
# Nesse caso use um listener dedicado com TLS, adicione
# sslprofile="Servers" ao <bind> e ao <link>, restrinja
# allowmask ao IP do host Services e configure o Anope com
# ssl=yes e um modulo SSL suportado.


