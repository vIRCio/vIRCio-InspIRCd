# ==========================================================
# WebIRC
# ==========================================================

# Gateways WebIRC locais exigem CIDR e hash proprios.
# Nunca usar mask="*" em producao.

#<gateway
#    type="webirc"
#    password="HASH_BCRYPT"
#    hash="bcrypt"
#    mask="IP_OU_CIDR_DO_GATEWAY">

# Tambem sera necessario criar uma classe de entrada para os
# IPs dos gateways com localmax/globalmax elevados antes do
# comando WEBIRC revelar o IP real do usuario.

#<connect
#    name="webirc-gateway"
#    parent="users"
#    allow="IP_OU_CIDR_DO_GATEWAY"
#    localmax="1000"
#    globalmax="1000"
#    usednsbl="no"
#    useident="no"
#    resolvehostnames="no"
#    useconnectban="no"
#    useconnflood="no">


# ==========================================================
# Links entre IRCds
# ==========================================================

# Um bloco <link> e necessario para cada IRCd remoto.

#<link
#    name="irc2.vircio.net"
#    ipaddr="IP_OU_HOST_DO_IRC2"
#    port="&serverTLSPort;"
#    allowmask="IP_OU_CIDR_DO_IRC2"
