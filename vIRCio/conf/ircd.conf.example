############################################################
#                                                          #
#                 Rede vIRCio - ircd.conf                  #
#                                                          #
# Este arquivo contem configuracoes especificas deste IRCd #
# e pode ser personalizado para cada servidor da rede.     #
#                                                          #
############################################################


# ==========================================================
# Variaveis especificas deste IRCd
# ==========================================================

<define name="serverName" value="irc1.vircio.net">
<define name="serverId" value="1AA">

<define name="bindIPv4" value="0.0.0.0">

# IMPORTANTE:
# A mesma cloakKey deve ser usada em todos os IRCds da rede.
# Futuramente sera fornecida por Docker Secret/env.
<define name="cloakKey" value="ALTERAR_CLOAK_KEY">

# Certificado atual de laboratorio.
# Em producao usar Let's Encrypt fullchain.pem + privkey.pem.
<define name="tlsCertFile" value="/CAMINHO/PARA/fullchain.pem">
<define name="tlsKeyFile" value="/CAMINHO/PARA/privkey.pem">


# ==========================================================
# Servidor
# ==========================================================

<server
    name="&serverName;"
    description="&networkDescription;"
    id="&serverId;"
    network="&networkName;">


# ==========================================================
# OpenSSL
# ==========================================================

<openssl onrehash="yes">

<sslprofile
    name="Clients"
    provider="openssl"
    cafile=""
    certfile="&tlsCertFile;"
    keyfile="&tlsKeyFile;"
    hash="sha256"
    compression="no"
    renegotiation="no"
    requestclientcert="no"
    securitylevel="1"
    tlsv11="no"
    tlsv12="yes"
    tlsv13="yes">

<sslprofile
    name="Servers"
    provider="openssl"
    cafile=""
    certfile="&tlsCertFile;"
    keyfile="&tlsKeyFile;"
    hash="sha256"
    compression="no"
    renegotiation="no"
    requestclientcert="no"
    securitylevel="1"
    tlsv11="no"
    tlsv12="yes"
    tlsv13="yes">


# ==========================================================
# Listeners IPv4
# ==========================================================

# Clientes IRC sem TLS
<bind
    address="&bindIPv4;"
    port="&clientPort;"
    type="clients"
    defer="0"
    free="no">

# Clientes IRC com TLS
<bind
    address="&bindIPv4;"
    port="&clientTLSPort;"
    type="clients"
    sslprofile="Clients"
    defer="0"
    free="no">

# WebChat / WebSocket seguro - WSS
<bind
    address="&bindIPv4;"
    port="&websocketPort;"
    type="clients"
    hook="websocket"
    sslprofile="Clients"
    defer="0"
    free="no">

# Links entre IRCds via TLS
<bind
    address="&bindIPv4;"
    port="&serverTLSPort;"
    type="servers"
    sslprofile="Servers"
    defer="0"
    free="no">


