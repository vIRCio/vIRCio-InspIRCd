############################################################
#                                                          #
#                 Rede vIRCio - ircd.conf                  #
#                                                          #
# Este arquivo contem configuracoes especificas deste IRCd #
# e pode ser personalizado para cada servidor da rede.     #
#                                                          #
############################################################


# ==========================================================
# Variaveis especificas deste IRCd
# ==========================================================

<define name="serverName" value="irc1.vircio.net">
<define name="serverId" value="1AA">

<define name="bindIPv4" value="0.0.0.0">

# Chave comum de cloaking da rede; forneca fora do Git.
<define name="cloakKey" value="ALTERAR_CLOAK_KEY">

# Materiais TLS administrados no diretorio de configuracao do runtime.
<define name="tlsCertFile" value="/home/vircio/inspircd/conf/certs/irc-dev.crt">
<define name="tlsKeyFile" value="/home/vircio/inspircd/conf/certs/irc-dev.key">


# ==========================================================
# Servidor
# ==========================================================

<server
    name="&serverName;"
    description="&networkDescription;"
    id="&serverId;"
    network="&networkName;">


# ==========================================================
# OpenSSL
# ==========================================================

<openssl onrehash="yes">

<sslprofile
    name="Clients"
    provider="openssl"
    cafile=""
    certfile="&tlsCertFile;"
    keyfile="&tlsKeyFile;"
    hash="sha256"
    compression="no"
    renegotiation="no"
    requestclientcert="no"
    securitylevel="1"
    tlsv11="no"
    tlsv12="yes"
    tlsv13="yes">

<sslprofile
    name="IRCClients"
    provider="openssl"
    cafile=""
    certfile="&tlsCertFile;"
    keyfile="&tlsKeyFile;"
    hash="sha256"
    compression="no"
    renegotiation="no"
    requestclientcert="yes"
    securitylevel="1"
    tlsv11="no"
    tlsv12="yes"
    tlsv13="yes">

<sslprofile
    name="Servers"
    provider="openssl"
    cafile=""
    certfile="&tlsCertFile;"
    keyfile="&tlsKeyFile;"
    hash="sha256"
    compression="no"
    renegotiation="no"
    requestclientcert="no"
    securitylevel="1"
    tlsv11="no"
    tlsv12="yes"
    tlsv13="yes">


# ==========================================================
# Listeners IPv4
# ==========================================================

# Clientes IRC sem TLS
<bind
    address="&bindIPv4;"
    port="&clientPort;"
    type="clients"
    defer="0"
    free="no">

# Clientes IRC com TLS
<bind
    address="&bindIPv4;"
    port="&clientTLSPort;"
    type="clients"
    sslprofile="IRCClients"
    defer="0"
    free="no">

# WebChat / WebSocket seguro - WSS
<bind
    address="&bindIPv4;"
    port="&websocketPort;"
    type="clients"
    hook="websocket"
    sslprofile="Clients"
    defer="0"
    free="no">

# Links entre IRCds via TLS
<bind
    address="&bindIPv4;"
    port="&serverTLSPort;"
    type="servers"
    sslprofile="Servers"
    defer="0"
    free="no">

# Services / Anope local — somente loopback, sem TLS
<bind
    address="127.0.0.1"
    port="&servicesPort;"
    type="servers"
    defer="0"
    free="no">


# ==========================================================
